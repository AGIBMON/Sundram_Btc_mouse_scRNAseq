# =============================================================================
# 11. PATHWAY ENRICHMENT (GO, KEGG, Hallmark MSigDB)
# =============================================================================

deg_path      <- "#<OUTPUT DIRECTORY PATH>/pseudobulk"
padj_cutoff   <- 0.05
logfc_cutoff  <- 0.05

# Helper: map Ensembl IDs to gene symbols if needed
map_to_symbol <- function(ids) {
  mapped <- bitr(ids, fromType = "ENSEMBL", toType = "SYMBOL", OrgDb = org.Mm.eg.db)
  unique(mapped$SYMBOL)
}

# Hallmark gene sets (MSigDB)
msig_hallmark <- msigdbr(species = "Mus musculus", category = "H")

results_hallmark <- list()
results_GO       <- list()
results_KEGG     <- list()

for (file in list.files(deg_path, full.names = TRUE)) {

  cluster_name <- tools::file_path_sans_ext(basename(file))
  deg          <- read.csv(file)

  # Map Ensembl -> symbol if necessary
  is_ensembl <- all(grepl("ENSMUSG", head(deg$gene, 5)))
  sig_genes <- deg %>%
    filter(padj < padj_cutoff & abs(log2FoldChange) > logfc_cutoff) %>%
    pull(gene)

  if (is_ensembl) sig_genes <- map_to_symbol(sig_genes)

  if (length(sig_genes) == 0) {
    message("No DEGs passed thresholds for cluster ", cluster_name)
    next
  }

  # Hallmark ORA
  enr_h <- tryCatch(
    enricher(sig_genes,
             TERM2GENE    = msig_hallmark %>% dplyr::select(gs_name, gene_symbol),
             pvalueCutoff = 0.05),
    error = function(e) NULL
  )
  if (!is.null(enr_h)) {
    df <- enr_h@result; df$cluster <- cluster_name
    results_hallmark[[cluster_name]] <- df
  }

  # GO Biological Process
  enr_go <- tryCatch(
    enrichGO(gene         = sig_genes,
             OrgDb        = org.Mm.eg.db,
             keyType      = "SYMBOL",
             ont          = "BP",
             pAdjustMethod = "BH",
             pvalueCutoff = 0.05),
    error = function(e) NULL
  )
  if (!is.null(enr_go)) {
    df <- enr_go@result; df$cluster <- cluster_name
    results_GO[[cluster_name]] <- df
  }

  # KEGG
  enr_kegg <- tryCatch(
    enrichKEGG(gene         = sig_genes,
               organism     = "mmu",
               keyType      = "kegg",
               pvalueCutoff = 0.05),
    error = function(e) NULL
  )
  if (!is.null(enr_kegg)) {
    df <- enr_kegg@result; df$cluster <- cluster_name
    results_KEGG[[cluster_name]] <- df
  }
}

# Save combined results
write.csv(bind_rows(results_hallmark), "Hallmark_enrichment_all_clusters.csv", row.names = FALSE)
write.csv(bind_rows(results_GO),       "GO_BP_enrichment_all_clusters.csv",    row.names = FALSE)
write.csv(bind_rows(results_KEGG),     "KEGG_enrichment_all_clusters.csv",     row.names = FALSE)

message("Pathway enrichment complete. Results saved.")
