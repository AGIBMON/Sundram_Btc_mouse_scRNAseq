# =============================================================================
# 2. DATA LOADING & SEURAT OBJECT CREATION
# =============================================================================

setwd("#<OUTPUT DIRECTORY PATH>")

data <- Read10X(data.dir = "#<CELL RANGER DATA DIRECTORY PATH>/Data_Aggr/count/filtered_feature_bc_matrix/")

# Create Seurat object from Gene Expression matrix
seurat_object <- CreateSeuratObject(
  counts      = data[["Gene Expression"]],
  min.cells   = 3,
  min.features = 200,
  project     = "Btc"
)

# Attach multiplexing capture assay
seurat_object[["CMO"]] <- CreateAssayObject(
  counts = data[["Multiplexing Capture"]][, colnames(seurat_object)]
)


# =============================================================================
# 3. DEMULTIPLEXING & METADATA ASSIGNMENT
# =============================================================================

# Sample manifest: CMO tag -> sample ID, sex, condition
sample_info <- list(
  list(file      = "#<CELL RANGER DATA DIRECTORY PATH>/1593--_CMO_303_304/multi/multiplexing_analysis/tag_calls_per_cell.csv",
       mapping   = c("CMO303" = "KO1593_03", "CMO304" = "KO1593_04"),
       sex       = c("M", "M"),
       condition = "Mut"),
  list(file      = "#<CELL RANGER DATA DIRECTORY PATH>/1649--_CMO_301_302/multi/multiplexing_analysis/tag_calls_per_cell.csv",
       mapping   = c("CMO301" = "KO1649_01", "CMO302" = "KO1649_02"),
       sex       = c("M", "M"),
       condition = "Mut"),
  list(file      = "#<CELL RANGER DATA DIRECTORY PATH>/1593--_CMO_305_306/multi/multiplexing_analysis/tag_calls_per_cell.csv",
       mapping   = c("CMO305" = "KO1593_05", "CMO306" = "KO1593_06"),
       sex       = c("M", "M"),
       condition = "Mut"),
  list(file      = "#<CELL RANGER DATA DIRECTORY PATH>/1579++_CMO_309_310/multi/multiplexing_analysis/tag_calls_per_cell.csv",
       mapping   = c("CMO309" = "WT1579_09", "CMO310" = "WT1579_10"),
       sex       = c("M", "F"),
       condition = "WT"),
  list(file      = "#<CELL RANGER DATA DIRECTORY PATH>/1579++_CMO_311_312/multi/multiplexing_analysis/tag_calls_per_cell.csv",
       mapping   = c("CMO311" = "WT1579_11", "CMO312" = "WT1579_12"),
       sex       = c("F", "F"),
       condition = "WT")
)

# Read each CSV, assign sample ID / sex / condition, remove doublets
all_samples <- lapply(sample_info, function(info) {
  df <- read.csv(info$file)

  for (cmo in names(info$mapping)) {
    df$sample[df$feature_call == cmo] <- info$mapping[[cmo]]
  }
  for (i in seq_along(info$mapping)) {
    df$Sex[df$sample == info$mapping[[i]]] <- info$sex[i]
  }

  df$Condition <- info$condition

  cat("\n", basename(info$file), "before doublet removal:\n")
  print(table(df$num_features))

  df <- df[df$num_features == 1, ]   # remove doublets

  cat(basename(info$file), "after doublet removal:\n")
  print(table(df$num_features))

  return(df)
})

combined <- do.call(rbind, all_samples)

# Sanity checks
table(combined$Condition)
table(combined$Sex)

combined %>%
  group_by(sample, Condition) %>%
  summarise(n_cells = n(), .groups = "drop") %>%
  group_by(Condition) %>%
  summarise(avg_cells = mean(n_cells), sd_cells = sd(n_cells), n_samples = n())

combined %>%
  group_by(sample, Sex) %>%
  summarise(n_cells = n(), .groups = "drop") %>%
  group_by(Sex) %>%
  summarise(avg_cells = mean(n_cells), sd_cells = sd(n_cells), n_samples = n())

# Add metadata to Seurat object
seurat_object <- AddMetaData(seurat_object, combined$sample,    col.name = "Sample_ID")
seurat_object <- AddMetaData(seurat_object, combined$Sex,       col.name = "Sex")
seurat_object <- AddMetaData(seurat_object, combined$Condition, col.name = "Condition")


# =============================================================================
# 4. QC FILTERING
# =============================================================================

# --- 4a. Remove Y-chromosome genes to eliminate sex bias ---
#"Y_genes.csv contains a list of all Y-linked genes and the X chromosome inactivation gene Xist
y_genes_df  <- read.csv("Y_genes.csv", header = TRUE, stringsAsFactors = FALSE)
y_genes     <- y_genes_df[["Gene.name"]]
present_y   <- intersect(y_genes, rownames(seurat_object[["RNA"]]))

message(length(present_y), " of ", length(y_genes),
        " Y-chromosome genes found and will be removed: ",
        paste(present_y, collapse = ", "))

seurat_object[["RNA"]] <- subset(
  seurat_object[["RNA"]],
  features = setdiff(rownames(seurat_object[["RNA"]]), present_y)
)

# --- 4b. Mitochondrial content filter ---
seurat_object$percent.mito <- PercentageFeatureSet(seurat_object, pattern = "^mt-")

VlnPlot(seurat_object, features = "percent.mito")
VlnPlot(seurat_object, features = "percent.mito", group.by = "Condition")

# Check retention rates at various thresholds
for (thresh in c(5, 10, 15, 20, 25, 30)) {
  cat(sprintf("<%.0f%% mt: %.1f%% cells retained\n",
              thresh, 100 * mean(seurat_object$percent.mito < thresh)))
}

seurat_object <- subset(seurat_object, subset = percent.mito < 5)
VlnPlot(seurat_object, features = "percent.mito", group.by = "Condition")

# Cell counts after mito filter
cat("Cells remaining by Condition:\n"); print(table(seurat_object$Condition))
cat("Cells remaining by Sex:\n");       print(table(seurat_object$Sex))
cat("Cells remaining by Sample_ID:\n"); print(table(seurat_object$Sample_ID))
cat("Total cells remaining:", ncol(seurat_object), "\n")

saveRDS(seurat_object, "seurat_object.Rds")


# =============================================================================
# 5. DECONTX – AMBIENT RNA REMOVAL
# =============================================================================

# --- 5a. Quick clustering for DecontX input ---
seurat_tmp <- NormalizeData(seurat_object)
seurat_tmp <- FindVariableFeatures(seurat_tmp, nfeatures = 2000)
seurat_tmp <- ScaleData(seurat_tmp)
seurat_tmp <- RunPCA(seurat_tmp, verbose = FALSE)
ElbowPlot(seurat_tmp)   # plateau ~PC12 -> use dims 1:12

seurat_tmp <- FindNeighbors(seurat_tmp, dims = 1:12)

for (res in seq(0.2, 2, by = 0.2)) {
  seurat_tmp <- FindClusters(seurat_tmp, resolution = res, verbose = FALSE)
}
clustree(seurat_tmp, prefix = "RNA_snn_res.")
seurat_tmp <- FindClusters(seurat_tmp, resolution = 0.2)   # coarse clusters for DecontX

# --- 5b. Run DecontX ---
sce                     <- as.SingleCellExperiment(seurat_object)
sce$cluster_for_decontx <- as.character(Idents(seurat_tmp))
sce                     <- decontX(sce, z = sce$cluster_for_decontx)
saveRDS(sce, "sce.Rds")

# --- 5c. Inspect haemoglobin contamination before / after DecontX ---
haem_genes      <- c("Hbb-bt", "Hbb-bs", "Hbb-y", "Hba-a1", "Hbq1b", "Hba-a2", "Hbq1a")
haem_genes      <- intersect(haem_genes, rownames(sce))   # keep only present genes
contam_frac     <- colData(sce)$decontX_contamination
corrected_counts <- decontXcounts(sce)

haem_orig      <- colSums(counts(sce)[haem_genes, , drop = FALSE]) / colSums(counts(sce))
haem_corrected <- colSums(corrected_counts[haem_genes, , drop = FALSE]) / colSums(corrected_counts)

haem_df   <- data.frame(Cell = colnames(sce), Original = haem_orig, Corrected = haem_corrected)
haem_melt <- melt(haem_df, id.vars = "Cell", variable.name = "Stage", value.name = "HaemFraction")

ggplot(haem_melt, aes(x = HaemFraction, fill = Stage)) +
  geom_histogram(position = "identity", alpha = 0.5, bins = 50) +
  scale_x_log10() +
  theme_classic() +
  labs(title = "Haemoglobin fraction per cell before and after DecontX",
       x = "Haemoglobin fraction (log scale)", y = "Number of cells")

# --- 5d. Remove highly contaminated cells (>30%) ---
sce_filtered <- sce[, contam_frac < 0.3]

cat("Original cells:", ncol(seurat_object), "\n")
cat("Cells after DecontX filter:", ncol(sce_filtered), "\n")
cat("Cells removed:", ncol(seurat_object) - ncol(sce_filtered), "\n")
cat("Fraction retained:", ncol(sce_filtered) / ncol(seurat_object), "\n")

# Subset Seurat object and replace counts with DecontX-corrected values
seurat_object <- subset(seurat_object, cells = colnames(sce_filtered))
seurat_object[["RNA"]] <- SetAssayData(
  seurat_object[["RNA"]],
  layer    = "counts",
  new.data = decontXcounts(sce_filtered)
)

saveRDS(seurat_object, "seurat_object.Rds")


# =============================================================================
# 6. BLOOD CONTAMINATION REMOVAL
# =============================================================================

blood_genes_mouse <- c(
  "Hba-a1", "Hba-a2", "Hbb-bs", "Hbb-bt", "Hbb-b1", "Hbb-b2",
  "Lyz2", "S100a8", "S100a9", "C1qa", "C1qb", "C1qc",
  "Pf4", "Ppbp", "Ptprc", "Cd14", "Csf1r", "Mpo"
)
blood_genes_present <- intersect(blood_genes_mouse, rownames(seurat_object[["RNA"]]))

if (length(blood_genes_present) == 0) {
  stop("No blood marker genes found. Check gene naming (case sensitivity).")
}

# Module score for blood gene expression
seurat_object <- AddModuleScore(seurat_object, features = list(blood_genes_present), name = "Blood")
VlnPlot(seurat_object, features = "Blood1", group.by = "Condition")

# Correlate each gene with blood score (Spearman)
expr       <- GetAssayData(seurat_object, slot = "data")
blood_score <- seurat_object$Blood1

cor_vals <- apply(expr, 1, function(x)
  cor(x, blood_score, method = "spearman", use = "pairwise.complete.obs"))

cor_p <- sapply(rownames(expr), function(g) {
  x <- expr[g, ]
  if (sd(x) == 0) return(NA)
  cor.test(x, blood_score, method = "spearman")$p.value
})

cor_df <- data.frame(
  gene = rownames(expr),
  rho  = cor_vals,
  pval = cor_p,
  padj = p.adjust(cor_p, "BH")
)

suspect_genes <- cor_df$gene[abs(cor_df$rho) > 0.75 & cor_df$padj < 0.05]
cat("Suspect blood-correlated genes:", length(suspect_genes), "\n")

# Remove blood-correlated genes from variable features
VariableFeatures(seurat_object) <- setdiff(VariableFeatures(seurat_object), suspect_genes)

# Remove blood genes from the dataset
seurat_object <- subset(seurat_object,
                         features = setdiff(rownames(seurat_object), blood_genes_mouse))


# =============================================================================
# 7. NORMALISATION, VARIABLE FEATURES, SCALING & PCA
# =============================================================================

