seurat_object  <- seurat_object[total_per_gene >= 50, ]

seurat_object <- ScaleData(seurat_object)
seurat_object <- RunPCA(seurat_object, features = VariableFeatures(seurat_object))

# PCA diagnostics
DimPlot(seurat_object, reduction = "pca")
DimHeatmap(seurat_object, dims = 1:20, cells = 500, balanced = TRUE)
ElbowPlot(seurat_object)   # plateau ~PC12 -> use dims 1:14

seurat_object <- JackStraw(seurat_object, num.replicate = 100)
seurat_object <- ScoreJackStraw(seurat_object, dims = 1:14)
JackStrawPlot(seurat_object, dims = 1:14, reduction = "pca")

saveRDS(seurat_object, "seurat_object.Rds")


# =============================================================================
# 8. HARMONY INTEGRATION, UMAP & CLUSTERING
# =============================================================================

# --- 8a. Check for batch effects before Harmony ---
DimPlot(seurat_object, reduction = "umap", group.by = "Condition")
DimPlot(seurat_object, reduction = "umap", group.by = "Sex")
DimPlot(seurat_object, reduction = "umap", group.by = "Sample_ID")

pca_embed <- Embeddings(seurat_object, "pca")[, 1:14]
r2_per_pc  <- apply(pca_embed, 2, function(pc)
  summary(lm(pc ~ seurat_object$Sample_ID))$adj.r.squared)
print(r2_per_pc)   # consistently low R² -> minimal batch effect

# --- 8b. Run Harmony ---
seurat_object <- RunHarmony(
  seurat_object,
  group.by.vars = c("Condition", "Sex", "Sample_ID"),
  reduction      = "pca",
  reduction.save = "harmony"
)

DimPlot(seurat_object, reduction = "harmony", group.by = "Condition")
DimPlot(seurat_object, reduction = "harmony", group.by = "Sex")

# --- 8c. UMAP from Harmony embedding ---
seurat_object <- RunUMAP(seurat_object, reduction = "harmony", dims = 1:14,
                          reduction.name = "umap_harmony")

# --- 8d. Cluster at multiple resolutions; choose via clustree ---
seurat_object <- FindNeighbors(seurat_object, reduction = "harmony", dims = 1:14)

for (res in seq(0.2, 2, by = 0.2)) {
  seurat_object <- FindClusters(seurat_object, resolution = res, verbose = FALSE)
}
clustree(seurat_object, prefix = "RNA_snn_res.")
ggsave("plots/RNA_snn_res.png", plot = last_plot())

# Select resolution 0.4 based on clustree stability
seurat_object <- FindClusters(seurat_object, resolution = 0.4)
seurat_object$harmony_clusters <- seurat_object$seurat_clusters

DimPlot(seurat_object, reduction = "umap_harmony", group.by = "harmony_clusters")

