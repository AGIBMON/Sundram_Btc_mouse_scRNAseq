Idents(seurat_object) <- seurat_object$harmony_clusters_subcl

for (cluster in levels(seurat_object)) {
  seurat_cluster <- seurat_object[, seurat_object@active.ident == cluster]

  celltypes <- unique(seurat_cluster$celltype_short)
  celltype  <- if (length(celltypes) > 1) {
    warning("Cluster ", cluster, " has multiple cell types: ", paste(celltypes, collapse = ", "))
    paste(celltypes, collapse = "_")
  } else {
    celltypes
  }

  Idents(seurat_cluster) <- seurat_cluster$Condition
  de_result <- FindMarkers(
    seurat_cluster,
    ident.1            = "WT",
    ident.2            = "Mut",
    logfc.threshold    = 0.25,
    min.cells.feature  = 3,
    min.cells.group    = 3,
    min.pct            = 0,
    only.pos           = FALSE
  )

  de_result$AveExpr <- rowMeans(
    GetAssayData(seurat_cluster, assay = "RNA", layer = "data")[rownames(de_result), ]
  )

  significant <- de_result[!is.na(de_result$p_val_adj) & de_result$p_val_adj < 0.05, ]

  if (nrow(significant) == 0) {
    message("No significant DEGs for cluster ", cluster, " (", celltype, "), skipping.")
    next
  }

  celltype_safe <- gsub("[^A-Za-z0-9_\\-]", "_", celltype)
  write.csv(significant,
            file.path(output_dir_fm, paste0(cluster, "-", celltype_safe, ".csv")),
            row.names = TRUE)
  message("Saved FindMarkers DEGs: cluster ", cluster, " (", celltype, ")")
}

# ---- 10b. Pseudobulk DESeq2 --------------------------------------------------
output_dir_pb <- "#<OUTPUT DIRECTORY PATH>/PseudobulkClusters"
if (!dir.exists(output_dir_pb)) dir.create(output_dir_pb, recursive = TRUE)

cluster_col   <- "celltype_short"
condition_col <- "Condition"
sample_col    <- "Sample_ID"
exclude_clusters <- c("7", "9", "12", "14", "15", "16")

clusters <- setdiff(unique(as.character(seurat_object[[cluster_col]][, 1])), exclude_clusters)
message("Running pseudobulk DESeq2 for clusters: ", paste(clusters, collapse = ", "))

for (cluster in clusters) {
  message("Processing cluster ", cluster, " ...")

  seu_cluster <- subset(seurat_object, subset = !!as.name(cluster_col) == cluster)
  meta        <- seu_cluster@meta.data
  counts      <- GetAssayData(seu_cluster, assay = "RNA", slot = "counts")

  # Pseudobulk by sample
  pb_counts <- t(rowsum(t(as.matrix(counts)), group = meta[[sample_col]]))

  sample_info_sub <- meta %>%
    distinct(!!sym(sample_col), .keep_all = TRUE) %>%
    select(all_of(c(sample_col, condition_col)))

  # Match column names
  colnames(pb_counts)       <- make.names(colnames(pb_counts))
  rownames(sample_info_sub) <- make.names(sample_info_sub[[sample_col]])
  sample_info_sub           <- sample_info_sub[colnames(pb_counts), , drop = FALSE]

  if (length(unique(sample_info_sub[[condition_col]])) < 2) {
    message("Skipping cluster ", cluster, ": only one condition present.")
    next
  }

  dds <- DESeqDataSetFromMatrix(
    countData = pb_counts,
    colData   = sample_info_sub,
    design    = as.formula(paste0("~", condition_col))
  )
  dds <- dds[rowSums(counts(dds)) >= 10, ]
  dds[[condition_col]] <- relevel(dds[[condition_col]], ref = "WT")
  dds <- DESeq(dds)

  res        <- as.data.frame(results(dds, contrast = c(condition_col, "Mut", "WT")))
  res        <- res[order(res$pvalue), ]
  res$gene   <- rownames(res)
  res$mean_norm_counts <- rowMeans(counts(dds, normalized = TRUE))

  cluster_clean <- gsub("[^A-Za-z0-9_\\-]", "_", cluster)
  write.csv(res,
            file.path(output_dir_pb, paste0("Cluster_", cluster_clean, "_DESeq2_all.csv")),
            row.names = FALSE)

  sig <- subset(res, padj < 0.05)
  if (nrow(sig) > 0) {
    write.csv(sig,
              file.path(output_dir_pb, paste0("Cluster_", cluster_clean, "_DESeq2_FDR0.05.csv")),
              row.names = FALSE)
    message("Finished cluster ", cluster, " — total: ", nrow(res), ", significant: ", nrow(sig))
  } else {
    message("No significant DEGs for cluster ", cluster)
  }
}

