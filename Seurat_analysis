# ---- Helper: pseudobulk balance check ----------------------------------------
check_pseudobulk_balance <- function(seurat_object,
                                      cluster_col   = "celltype_short",
                                      sample_col    = "Sample_ID",
                                      condition_col = "Condition",
                                      min_samples   = 2) {
  meta <- seurat_object@meta.data

  summary_df <- meta %>%
    group_by(!!sym(cluster_col), !!sym(sample_col), !!sym(condition_col)) %>%
    summarise(cell_count = n(), .groups = "drop") %>%
    group_by(!!sym(cluster_col), !!sym(condition_col)) %>%
    summarise(n_samples   = n_distinct(!!sym(sample_col)),
              total_cells = sum(cell_count), .groups = "drop") %>%
    pivot_wider(names_from  = !!sym(condition_col),
                values_from = c(n_samples, total_cells),
                values_fill = 0)

  conds <- unique(meta[[condition_col]])
  col1  <- paste0("n_samples_", conds[1])
  col2  <- paste0("n_samples_", conds[2])

  summary_df <- summary_df %>%
    mutate(eligible_for_DE = !!sym(col1) >= min_samples & !!sym(col2) >= min_samples)

  return(summary_df)
}

cluster_check <- check_pseudobulk_balance(seurat_object)
